{$DOMAIN} {
    encode gzip zstd

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Reverse proxy to kodekloud-mcp service on internal Docker network
    reverse_proxy kodekloud-mcp:8000 {
        # Flush intervals for real-time SSE streaming
        flush_interval -1
    }
}
