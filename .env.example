# ==============================================================================
# kodekloud-mcp Configuration Example
# Copy this file to .env and customize values for your environment.
# NEVER commit your actual .env file with your real credentials!
# ==============================================================================

# Primary Authentication Credential (KodeKloud Learn - Optional when KODEKLOUD_USE_MOCK=true)
# Paste either:
# 1. Your full browser Cookie string copied from DevTools (e.g., "_session_id=...; remember_token=...")
# 2. Or a Bearer token / bare JWT string (e.g., "Bearer eyJhbGci..." or "eyJhbGci...")
# The server automatically detects Bearer/JWT vs Cookie format.
KODEKLOUD_SESSION_COOKIE=your_session_cookie_or_jwt_here

# KodeKloud Engineer Authentication Credential (Optional)
# If engineer.kodekloud.com uses a separate session cookie/token from learn.kodekloud.com,
# set it here. If omitted, KODEKLOUD_SESSION_COOKIE will be used as a fallback.
KODEKLOUD_ENGINEER_SESSION_COOKIE=your_engineer_session_cookie_or_jwt_here

# KodeKloud Engineer API Base URL (used when KODEKLOUD_USE_MOCK=false)
KODEKLOUD_ENGINEER_BASE_URL=https://engineer.kodekloud.com/api

# Mock Mode (default: true)
# Set to 'true' to use realistic mock data without making requests to KodeKloud.
# Set to 'false' to communicate with live KodeKloud endpoints using your session cookie.
KODEKLOUD_USE_MOCK=true

# Write Tools (default: false)
# Read-only by default. Set to 'true' to enable state-changing tools like start_lab and stop_lab.
KODEKLOUD_ENABLE_WRITE_TOOLS=false

# Cache TTL in seconds (default: 60)
# Responses are cached in-memory to prevent hammering KodeKloud endpoints.
KODEKLOUD_CACHE_TTL_SECONDS=60

# API Base URL (used when KODEKLOUD_USE_MOCK=false)
# TODO: Update if your account/region uses a different base URL
KODEKLOUD_API_BASE_URL=https://api.kodekloud.com/api/v1

# Domain Configuration (Required for docker-compose.prod.yml with Caddy HTTPS)
# Point an 'A' DNS record from this domain/subdomain to your VPS IP address.
DOMAIN=mcp.yourdomain.com

# Transport Mode ('stdio', 'http', 'sse', 'streamable-http', default: stdio)
# - Use 'stdio' when running locally on your machine for Claude Desktop / Cursor.
# - Use 'http' (or 'sse') on your VPS so remote clients can connect:
#     * Anthropic Claude Custom Connector: https://your-domain/mcp (Streamable HTTP)
#     * Google Gemini Connected Apps:      https://your-domain/mcp (Streamable HTTP)
#     * OpenAI ChatGPT Custom GPT/Action:  https://your-domain/sse (SSE)
KODEKLOUD_MCP_TRANSPORT=http

# HTTP Server Host and Port (used when transport is 'http', 'sse', or 'streamable-http')
KODEKLOUD_MCP_HOST=0.0.0.0
KODEKLOUD_MCP_PORT=8000

# Logging Level ('DEBUG', 'INFO', 'WARNING', 'ERROR', default: INFO)
# Note: All logs are strictly output to stderr to protect the stdio protocol.
KODEKLOUD_LOG_LEVEL=INFO
